# LabLedger configuration — copy to .env and edit. All values are optional;
# the app runs with sensible defaults and needs no external services.

# Secret key for Flask sessions (a random one is generated per boot if unset).
LABLEDGER_SECRET=change-me

# SQLite database location (default: labledger.db next to app.py).
# LABLEDGER_DB=./labledger.db

# Instrument bridge TCP listener.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5056

# AI analyst — live LLM mode (optional; falls back to a built-in expert engine).
XAI_API_KEY=
# Any OpenAI-compatible endpoint instead of xAI:
# LABLEDGER_AI_BASE=https://api.openai.com/v1
# LABLEDGER_AI_KEY=
